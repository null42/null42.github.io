<div
	class="article-reading-progress"
	data-article-reading-progress
	role="progressbar"
	aria-label="文章阅读进度"
	aria-valuemin="0"
	aria-valuemax="100"
	aria-valuenow="0"
>
	<div class="article-reading-progress__label">
		<span>READING</span>
		<strong data-article-reading-progress-value>0%</strong>
	</div>
	<div class="article-reading-progress__track" aria-hidden="true">
		<i data-article-reading-progress-bar></i>
	</div>
</div>
