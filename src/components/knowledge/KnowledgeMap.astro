---
import navigation from "@/generated/knowledge-navigation.json";
import "@/styles/pages/knowledge-map.css";
type MapArticle = { articleId: string; title: string; slug?: string; difficulty?: string; tags?: string[]; quality?: string };
const mapNavigation = navigation as Array<{ id: string; title: string; routes: Array<{ id: string; title: string; stages: Array<{ id: string; title: string; articles: MapArticle[] }> }> }>;
---
<div class="knowledge-map" data-knowledge-map>
	{mapNavigation.map((section) => {
		const articleCount = section.routes.reduce((routeTotal, route) => routeTotal + route.stages.reduce((stageTotal, stage) => stageTotal + stage.articles.length, 0), 0);
		return <section class="knowledge-map__section" id={`section-${section.id}`}>
			<header><div><p>Knowledge Section</p><h2>{section.title}</h2></div><a href={`/list/?scope=knowledge&section=${section.id}`}>{articleCount} 篇文章</a></header>
			<div class="knowledge-map__routes">{section.routes.map((route) => <article class="knowledge-map__route">
				<header><h3>{route.title}</h3><a href={`/list/?scope=knowledge&section=${section.id}&route=${route.id}`}>筛选路线</a></header>
				{route.stages.map((stage) => <section class="knowledge-map__stage">
					<header><h4>{stage.title}</h4><span>{stage.articles.length} 篇</span></header>
					<ul>{stage.articles.map((article) => <li>
						{article.slug ? <a href={`/posts/${article.slug}/`}><strong>{article.title}</strong></a> : <strong data-knowledge-article-placeholder={article.articleId}>{article.title}</strong>}
						<div class="knowledge-map__meta">{article.difficulty && <span>{article.difficulty}</span>}{article.quality && <span>{article.quality}</span>}{article.tags?.slice(0, 3).map((tag) => <span>#{tag}</span>)}</div>
					</li>)}</ul>
				</section>)}
			</article>)}</div>
		</section>;
	})}
</div>
