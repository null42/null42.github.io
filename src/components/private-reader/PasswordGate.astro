---
/**
 * 密码门组件
 *
 * 用户输入密码后，通过 private-reader-controller 派生密钥并解密 manifest 中的 title/author。
 * 密码不存储、不传输；解密成功后隐藏密码门，显示阅读器。
 *
 * 安全：
 * - 密码输入框 autocomplete="off"，防止浏览器密码管理器泄漏
 * - 错误提示不区分"密码错误"与"密文损坏"，避免侧信道
 * - 解密成功后清空密码输入框，sessionStorage 不存储密码
 */
import { Icon } from "astro-icon/components"

interface Props {
	slug: string
	saltBase64: string
	encryptedTitle: string
	encryptedAuthor: string | null
}

const { slug, saltBase64, encryptedTitle, encryptedAuthor } = Astro.props
---

<div
	id={`password-gate-${slug}`}
	class="password-gate"
	data-private-reader="gate"
	data-slug={slug}
	data-salt={saltBase64}
	data-encrypted-title={encryptedTitle}
	data-encrypted-author={encryptedAuthor ?? ""}
	data-pagefind-ignore="all"
>
	<div class="password-gate-card card-base">
		<Icon name="material-symbols:shield-lock" class="password-gate-icon" />
		<h2 class="password-gate-title">加密文档</h2>
		<p class="password-gate-desc">此文档已加密，请输入密码以在浏览器本地解密。密码不会上传服务器。</p>
		<form class="password-gate-form" data-password-form>
			<input
				type="password"
				class="password-gate-input"
				placeholder="请输入密码"
				autocomplete="off"
				autocapitalize="off"
				autocorrect="off"
				spellcheck="false"
				data-password-input
			/>
			<button type="submit" class="password-gate-submit" data-password-submit>
				解锁
			</button>
		</form>
		<p class="password-gate-error hidden" data-password-error>
			解密失败，请检查密码是否正确。
		</p>
		<p class="password-gate-status hidden" data-password-status></p>
	</div>
</div>

<style>
	.password-gate {
		display: grid;
		place-items: center;
		padding: 2rem 1rem;
		min-height: 50vh;
	}

	.password-gate-card {
		display: grid;
		gap: 0.75rem;
		justify-items: center;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		max-width: 24rem;
		width: 100%;
		text-align: center;
	}

	.password-gate-icon {
		font-size: 4rem;
		color: var(--primary);
	}

	.password-gate-title {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
	}

	.password-gate-desc {
		margin: 0;
		color: var(--meta-divider);
		font-size: 0.88rem;
		line-height: 1.6;
	}

	.password-gate-form {
		display: grid;
		gap: 0.6rem;
		width: 100%;
		margin-top: 0.5rem;
	}

	.password-gate-input {
		width: 100%;
		padding: 0.6rem 0.85rem;
		border-radius: var(--radius-medium);
		border: 1px solid var(--line-divider);
		background: var(--btn-regular-bg);
		color: var(--content-text);
		font-size: 0.95rem;
		outline: none;
		transition: border-color 0.2s ease;
	}

	.password-gate-input:focus {
		border-color: var(--primary);
	}

	.password-gate-submit {
		width: 100%;
		padding: 0.65rem;
		border-radius: var(--radius-medium);
		border: none;
		background: var(--primary);
		color: white;
		font-size: 0.95rem;
		font-weight: 600;
		cursor: pointer;
		transition: opacity 0.2s ease, transform 0.1s ease;
	}

	.password-gate-submit:hover {
		opacity: 0.85;
	}

	.password-gate-submit:active {
		transform: scale(0.98);
	}

	.password-gate-submit:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.password-gate-error {
		margin: 0;
		color: #ef4444;
		font-size: 0.82rem;
	}

	.password-gate-status {
		margin: 0;
		color: var(--primary);
		font-size: 0.82rem;
	}

	.hidden {
		display: none;
	}
</style>
