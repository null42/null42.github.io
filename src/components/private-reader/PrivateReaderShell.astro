---
/**
 * 私密阅读器壳（v2 三层解密架构）
 *
 * 包含：
 * - Book 密码门（第三层，未解锁时显示）
 * - ReaderHost（阅读器主机，解锁后显示）
 *
 * 兼容性：
 * - v2 schema：使用 crypto.bookSalt 派生 bookKey，用 toc[0].title 验证
 * - v1 schema：使用 crypto.salt 派生 key，用 manifest.title 验证（向后兼容）
 *
 * 生命周期：
 * - 页面加载时初始化 private-reader-controller
 * - 用户输入 book 密码 → 派生 bookKey → 解密 toc[0].title 验证 → 解锁阅读器
 * - 离开路由时 dispose 清空密钥与缓存
 */
import ReaderHost from "./readers/ReaderHost.astro"

interface ManifestSegment {
	index: number
	file: string
	iv: string
	bytes: number
	charHint?: number
	chapterId?: string
}

interface ManifestTocEntry {
	id: string
	title: string
	segmentIndex: number
	anchor?: string
}

interface Manifest {
	schema: string
	kind: "txt" | "epub"
	slug: string
	title?: string         // v1: bookKey 加密
	author?: string | null // v1: bookKey 加密
	crypto: {
		algorithm: string
		kdf: string
		iterations: number
		salt?: string         // v1
		gateSalt?: string     // v2
		shelfSalt?: string    // v2
		bookSalt?: string     // v2
	}
	shelf?: {
		title: string         // v2: shelfKey 加密
		author: string | null
	}
	gate?: {
		token: string
	}
	toc?: ManifestTocEntry[]
	segments: ManifestSegment[]
	assets?: Record<string, any>
	reading: {
		estimatedTimeMin: number
	}
}

interface Props {
	manifest: Manifest
}

const { manifest } = Astro.props

// 根据 schema 版本提取 salt 和验证字段
const isV2 = manifest.schema === "private-reader/v2"
const bookSaltBase64 = isV2
	? (manifest.crypto.bookSalt || "")
	: (manifest.crypto.salt || "")

// v2 用 toc[0].title 验证，v1 用 manifest.title 验证
const verifyField = isV2
	? (manifest.toc && manifest.toc.length > 0 ? manifest.toc[0].title : "")
	: (manifest.title || "")
---

<div
	class="private-reader-shell"
	data-private-reader="shell"
	data-slug={manifest.slug}
	data-kind={manifest.kind}
	data-schema={manifest.schema}
	data-book-salt={bookSaltBase64}
	data-verify-field={verifyField}
	data-pagefind-ignore="all"
>
	{/* Book 密码门：解锁前显示 */}
	<div class="private-reader-gate-wrapper" data-gate-wrapper>
		<div class="book-gate card-base">
			<div class="book-gate-icon">📖</div>
			<h2 class="book-gate-title">第三层 · 阅读验证</h2>
			<p class="book-gate-desc">此文档已加密，请输入阅读密码以在浏览器本地解密。密码不会上传服务器。</p>
			<form class="book-gate-form" data-password-form>
				<input
					type="password"
					class="book-gate-input"
					placeholder="阅读密码"
					autocomplete="off"
					autocapitalize="off"
					autocorrect="off"
					spellcheck="false"
					data-password-input
				/>
				<button type="submit" class="book-gate-submit" data-password-submit>
					开始阅读
				</button>
			</form>
			<p class="book-gate-error hidden" data-password-error>
				密码错误，请重试。
			</p>
			<p class="book-gate-status hidden" data-password-status></p>
		</div>
	</div>

	{/* 阅读器：解锁后显示 */}
	<div class="private-reader-host-wrapper hidden" data-host-wrapper>
		<ReaderHost manifest={manifest} />
	</div>
</div>

<style>
	.private-reader-shell {
		display: grid;
		gap: 1rem;
	}

	.private-reader-gate-wrapper {
		display: grid;
		place-items: center;
		padding: 2rem 1rem;
		min-height: 50vh;
	}

	.book-gate {
		display: grid;
		gap: 0.75rem;
		justify-items: center;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		max-width: 24rem;
		width: 100%;
		text-align: center;
	}

	.book-gate-icon {
		font-size: 4rem;
		line-height: 1;
	}

	.book-gate-title {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
	}

	.book-gate-desc {
		margin: 0;
		color: var(--meta-divider);
		font-size: 0.88rem;
		line-height: 1.6;
	}

	.book-gate-form {
		display: grid;
		gap: 0.6rem;
		width: 100%;
		margin-top: 0.5rem;
	}

	.book-gate-input {
		width: 100%;
		padding: 0.6rem 0.85rem;
		border-radius: var(--radius-medium);
		border: 1px solid var(--line-divider);
		background: var(--btn-regular-bg);
		color: var(--content-text);
		font-size: 0.95rem;
		outline: none;
		transition: border-color 0.2s ease;
	}

	.book-gate-input:focus {
		border-color: var(--primary);
	}

	.book-gate-submit {
		width: 100%;
		padding: 0.65rem;
		border-radius: var(--radius-medium);
		border: none;
		background: var(--primary);
		color: white;
		font-size: 0.95rem;
		font-weight: 600;
		cursor: pointer;
		transition: opacity 0.2s ease, transform 0.1s ease;
	}

	.book-gate-submit:hover {
		opacity: 0.85;
	}

	.book-gate-submit:active {
		transform: scale(0.98);
	}

	.book-gate-submit:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.book-gate-error {
		margin: 0;
		color: #ef4444;
		font-size: 0.82rem;
	}

	.book-gate-status {
		margin: 0;
		color: var(--primary);
		font-size: 0.82rem;
	}

	.hidden {
		display: none !important;
	}
</style>

<script>
	/**
	 * 私密阅读器壳逻辑（v2 三层解密）
	 *
	 * 流程：
	 * 1. 用户输入 book 密码
	 * 2. 派生 bookKey（v2 用 bookSalt，v1 用 salt）
	 * 3. 解密 verifyField 验证密码正确性
	 * 4. 验证成功 → 隐藏密码门，显示阅读器，派发 unlocked 事件
	 */
	import { initPrivateReaderLifecycle } from "@/utils/private-reader-controller"

	const shell = document.querySelector<HTMLElement>("[data-private-reader='shell']")
	if (shell) {
		const slug = shell.getAttribute("data-slug") || ""
		const schema = shell.getAttribute("data-schema") || "v1"
		const bookSalt = shell.getAttribute("data-book-salt") || ""
		const verifyField = shell.getAttribute("data-verify-field") || ""

		const gateWrapper = shell.querySelector<HTMLElement>("[data-gate-wrapper]")
		const hostWrapper = shell.querySelector<HTMLElement>("[data-host-wrapper]")
		const form = shell.querySelector<HTMLFormElement>("[data-password-form]")
		const input = shell.querySelector<HTMLInputElement>("[data-password-input]")
		const submitBtn = shell.querySelector<HTMLButtonElement>("[data-password-submit]")
		const errorEl = shell.querySelector<HTMLElement>("[data-password-error]")
		const statusEl = shell.querySelector<HTMLElement>("[data-password-status]")

		const lifecycle = initPrivateReaderLifecycle()
		;(window as Window & { privateReaderLifecycle?: any }).privateReaderLifecycle = lifecycle

		const showStatus = (msg: string) => {
			if (statusEl) { statusEl.textContent = msg; statusEl.classList.remove("hidden") }
		}
		const hideStatus = () => { if (statusEl) statusEl.classList.add("hidden") }
		const showError = () => { errorEl?.classList.remove("hidden") }
		const hideError = () => { errorEl?.classList.add("hidden") }

		const unlock = async (password: string) => {
			if (!password) return
			hideError()
			hideStatus()
			if (submitBtn) submitBtn.disabled = true
			showStatus("正在派生阅读密钥…")

			try {
				// v2 用 deriveBookKey，v1 用 deriveBookKey（兼容，因为 v1 也用 bookSalt = salt）
				const key = await lifecycle.deriveBookKey(slug, password, bookSalt)

				showStatus("正在验证密码…")
				// 解密 verifyField 验证密码正确性
				let verified = false
				let decryptedTitle = ""
				try {
					decryptedTitle = await lifecycle.decryptBookField(verifyField, key)
					verified = true
				} catch {
					verified = false
				}

				if (!verified) {
					hideStatus()
					showError()
					return
				}

				// 解密成功，切换到阅读器
				if (input) input.value = ""
				hideStatus()
				if (gateWrapper) gateWrapper.classList.add("hidden")
				if (hostWrapper) hostWrapper.classList.remove("hidden")

				// 通知阅读器密钥已就绪
				document.dispatchEvent(new CustomEvent("private-reader:unlocked", {
					detail: { slug, key, title: decryptedTitle, schema }
				}))
			} catch (err) {
				hideStatus()
				showError()
			} finally {
				if (submitBtn) submitBtn.disabled = false
			}
		}

		form?.addEventListener("submit", (e) => {
			e.preventDefault()
			const pwd = input?.value?.trim()
			if (pwd) unlock(pwd)
		})

		// 离开路由时 dispose
		window.addEventListener("beforeunload", () => {
			lifecycle.dispose()
		})
		window.addEventListener("swup:leave:page", () => {
			lifecycle.dispose()
		})
	}
</script>
