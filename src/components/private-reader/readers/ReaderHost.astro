---
/**
 * 阅读器主机
 *
 * 根据 manifest.kind 渲染 TXT 或 EPUB 阅读器。
 * 两者共享相同的解密密钥与生命周期。
 */
interface ManifestSegment {
	index: number
	file: string
	iv: string
	bytes: number
	charHint?: number
	chapterId?: string
	href?: string
}

interface ManifestTocEntry {
	id: string
	title: string
	segmentIndex: number
	anchor?: string
}

interface ManifestAsset {
	file: string
	iv: string
	mediaType: string
	bytes: number
}

interface Manifest {
	schema: string
	kind: "txt" | "epub"
	slug: string
	title?: string
	author?: string | null
	crypto: {
		algorithm: string
		kdf: string
		iterations: number
		salt?: string
		gateSalt?: string
		shelfSalt?: string
		bookSalt?: string
	}
	shelf?: {
		title: string
		author: string | null
	}
	gate?: {
		token: string
	}
	segments: ManifestSegment[]
	toc?: ManifestTocEntry[]
	assets?: Record<string, ManifestAsset>
	reading: {
		estimatedTimeMin: number
	}
}

interface Props {
	manifest: Manifest
}

const { manifest } = Astro.props
const isTxt = manifest.kind === "txt"
const isEpub = manifest.kind === "epub"
---

<div
	class="reader-host"
	data-reader-host
	data-slug={manifest.slug}
	data-kind={manifest.kind}
	data-pagefind-ignore="all"
>
	<!-- 阅读器头部：标题、作者、控件 -->
	<header class="reader-header card-base" data-reader-header>
		<div class="reader-header-info">
			<h1 class="reader-title" data-reader-title>解密中…</h1>
			<p class="reader-author hidden" data-reader-author></p>
			<p class="reader-meta">
				<span class="reader-kind">{manifest.kind.toUpperCase()}</span>
				<span class="reader-segments">{manifest.segments.length} 段</span>
				{manifest.reading.estimatedTimeMin > 0 && (
					<span class="reader-time">约 {manifest.reading.estimatedTimeMin} 分钟</span>
				)}
			</p>
		</div>
		<div class="reader-controls" data-reader-controls>
			<button class="reader-btn" data-btn-toc title="目录">☰</button>
			<button class="reader-btn" data-btn-theme title="主题">🎨</button>
			<button class="reader-btn" data-btn-font title="字体">Aa</button>
			<button class="reader-btn" data-btn-prev title="上一段/章">‹</button>
			<button class="reader-btn" data-btn-next title="下一段/章">›</button>
		</div>
	</header>

	<!-- 阅读器主体 -->
	<main class="reader-body" data-reader-body>
		<div class="reader-loading" data-reader-loading>正在准备阅读器…</div>
		<div class="reader-content hidden" data-reader-content data-kind={manifest.kind}></div>
	</main>

	<!-- 进度条 + 底部章节切换 -->
	<footer class="reader-progress" data-reader-progress>
		<button class="reader-btn reader-nav-btn" data-btn-prev-bottom title="上一段/章" disabled>‹ 上一章</button>
		<div class="reader-progress-track">
			<div class="reader-progress-bar" data-reader-progress-bar style="width: 0%"></div>
			<span class="reader-progress-text" data-reader-progress-text>0%</span>
		</div>
		<button class="reader-btn reader-nav-btn" data-btn-next-bottom title="下一段/章">下一章 ›</button>
	</footer>

	<!-- 目录抽屉 -->
	<aside class="reader-toc-drawer hidden" data-toc-drawer>
		<div class="reader-toc-header">
			<h2>目录</h2>
			<button class="reader-toc-close" data-btn-toc-close>×</button>
		</div>
		<ul class="reader-toc-list" data-toc-list></ul>
	</aside>

	<!-- 主题/字体控件抽屉 -->
	<aside class="reader-settings-drawer hidden" data-settings-drawer>
		<div class="reader-settings-header">
			<h2>设置</h2>
			<button class="reader-settings-close" data-btn-settings-close>×</button>
		</div>
		<div class="reader-settings-body">
			<div class="reader-setting-group">
				<label>主题</label>
				<div class="reader-theme-options">
					<button data-theme="light">浅色</button>
					<button data-theme="dark">深色</button>
					<button data-theme="sepia">护眼</button>
				</div>
			</div>
			<div class="reader-setting-group">
				<label>字号 <span data-font-size-value>16</span>px</label>
				<input type="range" min="12" max="24" step="1" value="16" data-font-size />
			</div>
			<div class="reader-setting-group">
				<label>行高 <span data-line-height-value>1.8</span></label>
				<input type="range" min="1.4" max="2.2" step="0.1" value="1.8" data-line-height />
			</div>
			<div class="reader-setting-group">
				<label>页边距 <span data-margin-value>1</span>rem</label>
				<input type="range" min="0.5" max="3" step="0.5" value="1" data-margin />
			</div>
		</div>
	</aside>
</div>

<style>
	.reader-host {
		display: grid;
		gap: 1rem;
		--reader-font-size: 16px;
		--reader-line-height: 1.8;
		--reader-margin: 1rem;
	}

	.reader-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
		padding: 1rem;
		flex-wrap: wrap;
	}

	.reader-header-info {
		display: grid;
		gap: 0.25rem;
		flex: 1;
		min-width: 0;
	}

	.reader-title {
		margin: 0;
		font-size: 1.3rem;
		font-weight: 700;
		word-break: break-word;
	}

	.reader-author {
		margin: 0;
		color: var(--meta-divider);
		font-size: 0.88rem;
	}

	.reader-meta {
		margin: 0;
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		font-size: 0.78rem;
		color: var(--content-meta);
	}

	.reader-kind {
		color: var(--primary);
		font-weight: 600;
	}

	.reader-controls {
		display: flex;
		gap: 0.35rem;
		flex-wrap: wrap;
	}

	.reader-btn {
		min-width: 2.2rem;
		height: 2.2rem;
		border-radius: var(--radius-medium);
		border: 1px solid var(--line-divider);
		background: var(--btn-regular-bg);
		color: var(--content-text);
		cursor: pointer;
		font-size: 1rem;
		transition: background 0.2s ease;
	}

	.reader-btn:hover {
		background: var(--btn-regular-hover-bg, var(--primary));
		color: white;
	}

	.reader-body {
		min-height: 50vh;
		padding: 0 var(--reader-margin);
		font-size: var(--reader-font-size);
		line-height: var(--reader-line-height);
	}

	.reader-loading {
		padding: 2rem;
		text-align: center;
		color: var(--meta-divider);
	}

	.reader-content {
		word-break: break-word;
		font-family: var(--reader-font-family, inherit);
		transition: opacity 0.18s ease;
	}

	/* TXT 保留 pre-wrap 保留换行；EPUB 用 innerHTML 渲染 HTML 不需要 pre-wrap */
	.reader-content[data-kind="txt"] {
		white-space: pre-wrap;
	}

	.reader-content.fading {
		opacity: 0;
	}

	.reader-content :global(h1),
	.reader-content :global(h2),
	.reader-content :global(h3) {
		margin: 1rem 0 0.5rem;
	}

	.reader-content :global(p) {
		margin: 0 0 1rem;
	}

	.reader-content :global(img) {
		max-width: 100%;
		height: auto;
	}

	/* 图片加载占位 */
	.reader-content :global(img[data-loading="1"]) {
		opacity: 0.3;
		background: var(--btn-regular-bg);
		min-height: 2rem;
	}

	.reader-progress {
		position: sticky;
		bottom: 0;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background: var(--card-bg, var(--btn-regular-bg));
		border-top: 1px solid var(--line-divider);
	}

	.reader-progress-track {
		flex: 1;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
	}

	.reader-progress-bar {
		height: 4px;
		background: var(--primary);
		border-radius: 2px;
		transition: width 0.3s ease;
		flex: 1;
	}

	.reader-progress-text {
		font-size: 0.78rem;
		color: var(--meta-divider);
		min-width: 3rem;
		text-align: right;
	}

	.reader-nav-btn {
		padding: 0 0.75rem;
		font-size: 0.82rem;
		white-space: nowrap;
	}

	.reader-nav-btn:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}

	.reader-toc-drawer,
	.reader-settings-drawer {
		position: fixed;
		top: 0;
		right: 0;
		width: min(320px, 80vw);
		height: 100vh;
		background: var(--card-bg, var(--btn-regular-bg));
		box-shadow: var(--shadow-lg);
		z-index: 100;
		display: flex;
		flex-direction: column;
	}

	.reader-toc-header,
	.reader-settings-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1rem;
		border-bottom: 1px solid var(--line-divider);
	}

	.reader-toc-header h2,
	.reader-settings-header h2 {
		margin: 0;
		font-size: 1.1rem;
	}

	.reader-toc-close,
	.reader-settings-close {
		border: none;
		background: none;
		font-size: 1.5rem;
		cursor: pointer;
		color: var(--content-text);
	}

	.reader-toc-list {
		list-style: none;
		margin: 0;
		padding: 0.5rem;
		overflow-y: auto;
		flex: 1;
	}

	.reader-toc-list li {
		padding: 0.5rem 0.75rem;
		border-radius: var(--radius-small);
		cursor: pointer;
		font-size: 0.9rem;
	}

	.reader-toc-list li:hover {
		background: var(--btn-regular-bg);
	}

	.reader-toc-list li.active {
		background: var(--primary);
		color: white;
	}

	.reader-settings-body {
		padding: 1rem;
		overflow-y: auto;
		flex: 1;
		display: grid;
		gap: 1rem;
	}

	.reader-setting-group {
		display: grid;
		gap: 0.5rem;
	}

	.reader-setting-group label {
		font-size: 0.88rem;
		color: var(--meta-divider);
	}

	.reader-theme-options {
		display: flex;
		gap: 0.5rem;
	}

	.reader-theme-options button {
		flex: 1;
		padding: 0.5rem;
		border: 1px solid var(--line-divider);
		background: var(--btn-regular-bg);
		color: var(--content-text);
		border-radius: var(--radius-medium);
		cursor: pointer;
		font-size: 0.85rem;
	}

	.reader-theme-options button.active {
		background: var(--primary);
		color: white;
		border-color: var(--primary);
	}

	.reader-setting-group input[type="range"] {
		width: 100%;
	}

	.hidden {
		display: none !important;
	}

	/* 主题样式 */
	.reader-host[data-theme="light"] {
		--reader-bg: #ffffff;
		--reader-text: #1a1a1a;
	}

	.reader-host[data-theme="dark"] {
		--reader-bg: #1a1a1a;
		--reader-text: #e0e0e0;
	}

	.reader-host[data-theme="sepia"] {
		--reader-bg: #f4ecd8;
		--reader-text: #5b4636;
	}

	.reader-host[data-theme] .reader-content {
		color: var(--reader-text);
	}
</style>

<script>
	// 阅读器主机逻辑：监听解锁事件，加载并渲染内容
	const host = document.querySelector<HTMLElement>("[data-reader-host]")
	if (host) {
		const slug = host.getAttribute("data-slug") || ""
		const kind = host.getAttribute("data-kind") || ""
		const titleEl = host.querySelector<HTMLElement>("[data-reader-title]")
		const authorEl = host.querySelector<HTMLElement>("[data-reader-author]")
		const loadingEl = host.querySelector<HTMLElement>("[data-reader-loading]")
		const contentEl = host.querySelector<HTMLElement>("[data-reader-content]")
		const progressBar = host.querySelector<HTMLElement>("[data-reader-progress-bar]")
		const progressText = host.querySelector<HTMLElement>("[data-reader-progress-text]")
		const prevBtnBottom = host.querySelector<HTMLButtonElement>("[data-btn-prev-bottom]")
		const nextBtnBottom = host.querySelector<HTMLButtonElement>("[data-btn-next-bottom]")
		const tocDrawer = host.querySelector<HTMLElement>("[data-toc-drawer]")
		const tocList = host.querySelector<HTMLElement>("[data-toc-list]")
		const settingsDrawer = host.querySelector<HTMLElement>("[data-settings-drawer]")
		// 时序修复：lifecycle 由 PrivateReaderShell 在脚本加载时挂载到 window，
		// 但本脚本可能与 shell 脚本加载顺序不确定，故延迟至 unlocked 事件触发时再获取。
		let lifecycle: any = null

		let currentSegment = 0
		let totalSegments = 0
		let manifestData: any = null
		let cryptoKey: CryptoKey | null = null
		// 图片 blob URL 管理：章节切换时释放上一章的 blob URL，避免内存泄漏
		let currentBlobUrls: string[] = []
		// 加载锁：防止快速切换章节时并发加载导致内容错乱
		let loadingSegmentIndex = -1
		let activeSegmentRequest: AbortController | null = null

		// 监听解锁事件
		document.addEventListener("private-reader:unlocked", async (event: any) => {
			const { slug: unlockedSlug, key, title } = event.detail
			if (unlockedSlug !== slug) return
			cryptoKey = key
			lifecycle = (window as Window & { privateReaderLifecycle?: any }).privateReaderLifecycle
			if (!lifecycle) {
				loadingEl?.classList.add("hidden")
				if (contentEl) {
					contentEl.classList.remove("hidden")
					contentEl.textContent = "阅读器初始化失败：lifecycle 未就绪"
				}
				return
			}
			if (loadingEl) loadingEl.textContent = "正在加载书目信息…"
		manifestData = await fetchManifest(slug)
		if (!manifestData) return
		totalSegments = manifestData.segments.length

			// 显示标题（title 来自 unlocked 事件，已解密）
		if (titleEl) titleEl.textContent = title
		// 解密作者（v1: manifestData.author 用 bookKey 加密；v2: shelf.author 用 shelfKey 加密，此处无法解密）
		const authorEncrypted = manifestData.author || manifestData.shelf?.author
		const isV2 = manifestData.schema === "private-reader/v2"
		if (authorEncrypted && authorEl && !isV2) {
			try {
				const author = await lifecycle.decryptBookField(authorEncrypted, key)
				authorEl.textContent = author
				authorEl.classList.remove("hidden")
			} catch {}
		}

			// 隐藏加载，显示内容
			loadingEl?.classList.add("hidden")
			contentEl?.classList.remove("hidden")

			applyPersistedSettings()
			buildToc()
			const savedSegment = loadProgress()
			const initialSegment = savedSegment >= 0 && savedSegment < totalSegments ? savedSegment : 0
			await loadSegment(initialSegment)
		})

		async function fetchManifest(slug: string): Promise<any> {
			try {
				const res = await fetch(`/private-reader/${slug}/manifest.json`)
				if (!res.ok) throw new Error(`HTTP ${res.status}`)
				return await res.json()
			} catch {
				return null
			}
		}

		async function loadSegment(index: number): Promise<void> {
			if (!manifestData || !cryptoKey || index < 0 || index >= totalSegments) return
			const seg = manifestData.segments[index]
			if (!seg) return
			// 加载锁：如果用户快速切换，取消旧的加载（通过比较 index）
			loadingSegmentIndex = index
			activeSegmentRequest?.abort()
			const requestController = new AbortController()
			activeSegmentRequest = requestController

			// 1. 淡出旧内容（仅当内容已显示时）
			if (contentEl && !contentEl.classList.contains("hidden")) {
				contentEl.classList.add("fading")
				// 等待淡出动画
				await new Promise(r => setTimeout(r, 180))
				// 如果期间用户又切换了，放弃本次加载
				if (loadingSegmentIndex !== index) return
			}

			// 2. 释放上一章的图片 blob URL
			revokeBlobUrls()

			// 3. 显示 loading
			if (contentEl) {
				contentEl.classList.add("hidden")
				contentEl.classList.remove("fading")
			}
			loadingEl?.classList.remove("hidden")
		const segTotal = totalSegments
		if (loadingEl) loadingEl.textContent = `正在下载第 ${index + 1}/${segTotal} 段…`

		try {
			// 4. fetch + 解密
			const res = await fetch(`/private-reader/${slug}/${seg.file}`, { signal: requestController.signal })
			if (!res.ok) throw new Error(`HTTP ${res.status}`)
			const ciphertextBase64 = await res.text()
			// 期间用户又切换了，放弃渲染
			if (loadingSegmentIndex !== index) return
			if (loadingEl) loadingEl.textContent = `正在解密第 ${index + 1}/${segTotal} 段…`
			const text = await lifecycle.decryptSegment(slug, index, ciphertextBase64, seg.iv, cryptoKey)
			if (loadingSegmentIndex !== index) return

				// 5. 渲染内容
				if (contentEl) {
					if (kind === "epub") {
						contentEl.innerHTML = text
					} else {
						contentEl.textContent = text
					}
				}

				// 6. EPUB 图片 src 重写（异步，不阻塞渲染）
				if (kind === "epub" && manifestData.assets) {
					rewriteImageSrcs(seg.href)
				}

				// 7. 隐藏 loading，淡入新内容
				loadingEl?.classList.add("hidden")
				if (contentEl) {
					contentEl.classList.remove("hidden")
					// 触发淡入：先设为 fading（opacity:0），下一帧移除
					contentEl.classList.add("fading")
					requestAnimationFrame(() => {
						requestAnimationFrame(() => {
							contentEl.classList.remove("fading")
						})
					})
				}

				currentSegment = index
				updateProgress()
				saveProgress()
				updateTocActive()

				// 8. 滚动重置：回到阅读器主体顶部
				scrollReaderToTop()

				// 9. 预加载下一段（仅解密，利用 lifecycle 段缓存）
				preloadSegment(index + 1)
			} catch (err) {
				if (loadingSegmentIndex !== index) return
				if (err instanceof DOMException && err.name === "AbortError") return
				loadingEl?.classList.add("hidden")
				if (contentEl) {
					contentEl.classList.remove("hidden", "fading")
					contentEl.textContent = "段加载失败"
				}
			} finally {
				if (activeSegmentRequest === requestController) activeSegmentRequest = null
			}
		}

		/**
		 * 释放当前章节的所有图片 blob URL。
		 * 章节切换或离开页面时调用，避免内存泄漏。
		 */
		function revokeBlobUrls(): void {
			for (const url of currentBlobUrls) {
				try { URL.revokeObjectURL(url) } catch {}
			}
			currentBlobUrls = []
		}

		/**
		 * 滚动阅读器主体到顶部。
		 * 优先滚动 reader-body，其次滚动 window。
		 */
		function scrollReaderToTop(): void {
			try {
				if (!host) return
				const body = host.querySelector<HTMLElement>("[data-reader-body]")
				if (body) {
					body.scrollTo({ top: 0, behavior: "auto" })
				}
				window.scrollTo({ top: 0, behavior: "auto" })
			} catch {}
		}

		/**
		 * 重写 EPUB 章节中的图片 src 为 blob URL。
		 *
		 * 流程：
		 * 1. 查找 contentEl 中所有 img[src]
		 * 2. 解析 src 相对于章节 XHTML 路径，得到 ZIP 内完整路径
		 * 3. 查找 manifestData.assets[完整路径]
		 * 4. fetch asset 文件 → decryptAsset → Blob → URL.createObjectURL
		 * 5. 替换 img.src
		 *
		 * 异步执行：先设置 data-loading="1" 占位，解密完成后替换 src 并移除占位。
		 *
		 * @param chapterHref 当前章节 XHTML 在 ZIP 内的完整路径（如 "OEBPS/chapter1.xhtml"）
		 */
		function rewriteImageSrcs(chapterHref: string): void {
			if (!contentEl) return
			const imgs = contentEl.querySelectorAll<HTMLImageElement>("img[src]")
			if (imgs.length === 0) return

			const assets = manifestData?.assets as Record<string, { file: string; iv: string; mediaType: string }> | undefined
			if (!assets) return

			// 章节 XHTML 所在目录（用于解析相对路径）
			const chapterDir = chapterHref.includes("/") ? chapterHref.slice(0, chapterHref.lastIndexOf("/") + 1) : ""

			for (const img of imgs) {
				const rawSrc = img.getAttribute("src") || ""
				if (!rawSrc) continue
				// 跳过绝对 URL（http/https/data/blob）和锚点
				if (/^(https?:|data:|blob:|#)/i.test(rawSrc)) continue

				// 解析相对路径，得到 ZIP 内完整路径
				// 例如 chapterDir="OEBPS/", rawSrc="images/foo.jpg" → "OEBPS/images/foo.jpg"
				// 例如 chapterDir="OEBPS/ch1/", rawSrc="../images/foo.jpg" → "OEBPS/images/foo.jpg"
				const resolvedPath = resolveRelativePath(chapterDir, rawSrc)
				const assetInfo = assets[resolvedPath]
				if (!assetInfo) continue

				// 标记为加载中
				img.setAttribute("data-loading", "1")
				// 异步加载图片
				loadImageBlob(img, assetInfo)
			}
		}

		/**
		 * 解析 EPUB 内的相对路径，返回 ZIP 内完整路径。
		 * 使用 URL API 处理 ../ 等相对路径分量。
		 *
		 * @param baseDir 章节 XHTML 所在目录（如 "OEBPS/" 或 "OEBPS/ch1/"，可为空串表示根目录）
		 * @param relative 图片 src（如 "images/foo.jpg" 或 "../images/foo.jpg"）
		 * @returns ZIP 内完整路径（如 "OEBPS/images/foo.jpg" 或 "cover.jpg"）
		 */
		function resolveRelativePath(baseDir: string, relative: string): string {
			try {
				// 规范化 baseDir：确保以 / 结尾，使 URL 解析把它当作目录
				const normalizedBase = baseDir.endsWith('/') ? baseDir : baseDir + '/'
				// 用 file:/// 作为根，避免引入额外的伪根目录段
				const base = new URL(normalizedBase, "file:///")
				const resolved = new URL(relative, base)
				// pathname 形如 "/OEBPS/images/foo.jpg"，去掉开头的 "/"
				return decodeURIComponent(resolved.pathname).replace(/^\//, "")
			} catch {
				// fallback：简单拼接
				return baseDir + relative
			}
		}

		/**
		 * 加载单个图片资源：fetch → 解密 → Blob → URL.createObjectURL → 替换 img.src。
		 */
		async function loadImageBlob(img: HTMLImageElement, assetInfo: { file: string; iv: string; mediaType: string }): Promise<void> {
			try {
				const res = await fetch(`/private-reader/${slug}/${assetInfo.file}`)
				if (!res.ok) throw new Error(`HTTP ${res.status}`)
				const ciphertextBase64 = await res.text()
				const plaintext = await lifecycle.decryptAsset(ciphertextBase64, assetInfo.iv, cryptoKey!)
				const blob = new Blob([plaintext], { type: assetInfo.mediaType })
				const url = URL.createObjectURL(blob)
				currentBlobUrls.push(url)
				img.src = url
				img.removeAttribute("data-loading")
			} catch {
				// 加载失败：移除占位样式，保留原始 src（可能显示 broken image）
				img.removeAttribute("data-loading")
			}
		}

		/**
		 * 预加载指定段（仅 fetch + 解密，利用 lifecycle 段缓存）。
		 * 不渲染，不更新进度，后台静默执行。
		 */
		async function preloadSegment(index: number): Promise<void> {
			if (!manifestData || !cryptoKey || index < 0 || index >= totalSegments) return
			const seg = manifestData.segments[index]
			if (!seg) return
			try {
				// 如果已缓存，lifecycle.decryptSegment 会直接返回缓存
				// 这里通过 prefetch 触发缓存
				const res = await fetch(`/private-reader/${slug}/${seg.file}`)
				const ciphertextBase64 = await res.text()
				await lifecycle.decryptSegment(slug, index, ciphertextBase64, seg.iv, cryptoKey)
			} catch {
				// 预加载失败静默忽略
			}
		}

		function updateProgress(): void {
			const pct = totalSegments > 0 ? Math.round(((currentSegment + 1) / totalSegments) * 100) : 0
			if (progressBar) progressBar.style.width = `${pct}%`
			if (progressText) progressText.textContent = `${pct}%`
			// 同步顶部和底部 prev/next 按钮的 disabled 状态
			if (prevBtnBottom) prevBtnBottom.disabled = currentSegment <= 0
			if (nextBtnBottom) nextBtnBottom.disabled = currentSegment >= totalSegments - 1
		}

		function saveProgress(): void {
			try {
				localStorage.setItem(`private-reader:progress:${slug}`, String(currentSegment))
			} catch {}
		}

		function loadProgress(): number {
			try {
				const saved = localStorage.getItem(`private-reader:progress:${slug}`)
				return saved ? Number(saved) : 0
			} catch {
				return 0
			}
		}

		function buildToc(): void {
			if (!tocList || !manifestData) return
			tocList.innerHTML = ""
			const toc = manifestData.toc
			if (Array.isArray(toc) && toc.length > 0) {
				for (const entry of toc) {
					const li = document.createElement("li")
					// 先显示占位文本，异步解密后替换为真实章节标题
					li.textContent = `第 ${entry.segmentIndex + 1} 段`
					li.dataset.segmentIndex = String(entry.segmentIndex)
					li.addEventListener("click", () => {
						const idx = Number(li.dataset.segmentIndex)
						loadSegment(idx)
						tocDrawer?.classList.add("hidden")
					})
					tocList.appendChild(li)
					// EPUB：异步解密章节标题（用 bookKey）
				if (kind === "epub" && entry.title && cryptoKey) {
					lifecycle.decryptBookField(entry.title, cryptoKey).then((decrypted: string) => {
						if (decrypted) li.textContent = decrypted
					}).catch(() => {})
				}
				}
			} else {
				// TXT 无 TOC，按段构建
				for (let i = 0; i < totalSegments; i++) {
					const li = document.createElement("li")
					li.textContent = `第 ${i + 1} 段`
					li.dataset.segmentIndex = String(i)
					li.addEventListener("click", () => {
						loadSegment(i)
						tocDrawer?.classList.add("hidden")
					})
					tocList.appendChild(li)
				}
			}
		}

		/**
		 * 更新 TOC 中当前章节的高亮状态。
		 * 在 loadSegment 完成后调用。
		 */
		function updateTocActive(): void {
			if (!tocList) return
			const items = tocList.querySelectorAll<HTMLLIElement>("li")
			items.forEach(li => {
				const idx = Number(li.dataset.segmentIndex)
				li.classList.toggle("active", idx === currentSegment)
			})
			// 滚动当前项到可见区域
			const activeItem = tocList.querySelector<HTMLLIElement>("li.active")
			if (activeItem) {
				try { activeItem.scrollIntoView({ block: "nearest", behavior: "smooth" }) } catch {}
			}
		}

		function applyPersistedSettings(): void {
			try {
				const prefsStr = localStorage.getItem("private-reader:prefs")
				if (prefsStr) {
					const prefs = JSON.parse(prefsStr)
					if (prefs.theme) applyTheme(prefs.theme)
					if (prefs.fontSize) applyFontSize(prefs.fontSize)
					if (prefs.lineHeight) applyLineHeight(prefs.lineHeight)
					if (prefs.margin) applyMargin(prefs.margin)
				}
			} catch {}
		}

		function savePrefs(prefs: any): void {
			try {
				const existing = JSON.parse(localStorage.getItem("private-reader:prefs") || "{}")
				localStorage.setItem("private-reader:prefs", JSON.stringify({ ...existing, ...prefs }))
			} catch {}
		}

		function applyTheme(theme: string): void {
			host?.setAttribute("data-theme", theme)
			host?.querySelectorAll<HTMLButtonElement>("[data-theme]").forEach((btn) => {
				btn.classList.toggle("active", btn.getAttribute("data-theme") === theme)
			})
			savePrefs({ theme })
		}

		function applyFontSize(size: number): void {
			const input = host?.querySelector<HTMLInputElement>(`[data-font-size]`)
			if (input) input.value = String(size)
			host?.style.setProperty("--reader-font-size", `${size}px`)
			const valEl = host?.querySelector<HTMLElement>("[data-font-size-value]")
			if (valEl) valEl.textContent = String(size)
			savePrefs({ fontSize: size })
		}

		function applyLineHeight(lh: number): void {
			const input = host?.querySelector<HTMLInputElement>(`[data-line-height]`)
			if (input) input.value = String(lh)
			host?.style.setProperty("--reader-line-height", String(lh))
			const valEl = host?.querySelector<HTMLElement>("[data-line-height-value]")
			if (valEl) valEl.textContent = String(lh)
			savePrefs({ lineHeight: lh })
		}

		function applyMargin(m: number): void {
			const input = host?.querySelector<HTMLInputElement>(`[data-margin]`)
			if (input) input.value = String(m)
			host?.style.setProperty("--reader-margin", `${m}rem`)
			const valEl = host?.querySelector<HTMLElement>("[data-margin-value]")
			if (valEl) valEl.textContent = String(m)
			savePrefs({ margin: m })
		}

		// 控件绑定
		host.querySelector("[data-btn-toc]")?.addEventListener("click", () => {
			tocDrawer?.classList.toggle("hidden")
			settingsDrawer?.classList.add("hidden")
		})
		host.querySelector("[data-btn-theme]")?.addEventListener("click", () => {
			settingsDrawer?.classList.toggle("hidden")
			tocDrawer?.classList.add("hidden")
		})
		host.querySelector("[data-btn-font]")?.addEventListener("click", () => {
			settingsDrawer?.classList.toggle("hidden")
			tocDrawer?.classList.add("hidden")
		})
		host.querySelector("[data-btn-prev]")?.addEventListener("click", () => {
			if (currentSegment > 0) loadSegment(currentSegment - 1)
		})
		host.querySelector("[data-btn-next]")?.addEventListener("click", () => {
			if (currentSegment < totalSegments - 1) loadSegment(currentSegment + 1)
		})
		// 底部章节切换按钮（阅读到本章末尾时无需回到顶部即可切换）
		prevBtnBottom?.addEventListener("click", () => {
			if (currentSegment > 0) loadSegment(currentSegment - 1)
		})
		nextBtnBottom?.addEventListener("click", () => {
			if (currentSegment < totalSegments - 1) loadSegment(currentSegment + 1)
		})
		host.querySelector("[data-btn-toc-close]")?.addEventListener("click", () => {
			tocDrawer?.classList.add("hidden")
		})
		host.querySelector("[data-btn-settings-close]")?.addEventListener("click", () => {
			settingsDrawer?.classList.add("hidden")
		})
		host.querySelectorAll<HTMLButtonElement>("[data-theme]").forEach((btn) => {
			btn.addEventListener("click", () => applyTheme(btn.getAttribute("data-theme") || "light"))
		})
		host.querySelector<HTMLInputElement>("[data-font-size]")?.addEventListener("input", (e) => {
			applyFontSize(Number((e.target as HTMLInputElement).value))
		})
		host.querySelector<HTMLInputElement>("[data-line-height]")?.addEventListener("input", (e) => {
			applyLineHeight(Number((e.target as HTMLInputElement).value))
		})
		host.querySelector<HTMLInputElement>("[data-margin]")?.addEventListener("input", (e) => {
			applyMargin(Number((e.target as HTMLInputElement).value))
		})

		// 键盘导航
		document.addEventListener(`keydown`, (event) => {
			const target = event.target as HTMLElement | null
			if (event.key === `Escape`) {
				tocDrawer?.classList.add(`hidden`)
				settingsDrawer?.classList.add(`hidden`)
			}
			if (event.ctrlKey || event.metaKey || event.altKey || target?.matches(`input, textarea, select, [contenteditable=true]`)) {
				event.stopImmediatePropagation()
			}
		}, { capture: true })
		document.addEventListener("keydown", (e) => {
			if (e.key === "ArrowLeft" && currentSegment > 0) loadSegment(currentSegment - 1)
			if (e.key === "ArrowRight" && currentSegment < totalSegments - 1) loadSegment(currentSegment + 1)
		})

		// 离开页面时释放所有图片 blob URL，避免内存泄漏
		// 覆盖两种场景：SPA 导航（swup）和浏览器导航/关闭
		window.addEventListener("swup:leave:page", () => {
			revokeBlobUrls()
		}, { once: true })
		window.addEventListener("pagehide", () => {
			revokeBlobUrls()
		}, { once: true })
	}
</script>
