---
import { homeConfig } from "@/config/homeConfig";
---

<section class="home-data" data-home-section="data" aria-labelledby="home-data-title">
	<div class="home-section-heading">
		<p class="home-eyebrow">{homeConfig.labels.dataKicker}</p>
		<h2 id="home-data-title">{homeConfig.labels.dataTitle}</h2>
	</div>
	<div class="home-data__layout">
		<div class="home-data__metrics">
			{homeConfig.metrics.map((metric, index) => (
				<article class="home-metric">
					<p class="home-metric__number">{String(index + 1).padStart(2, "0")}</p>
					<strong>{metric.value}</strong>
					<h3>{metric.label}</h3>
					<p>{metric.detail}</p>
				</article>
			))}
		</div>
		<img src={homeConfig.media.data.src} alt={homeConfig.media.data.alt} width={homeConfig.media.data.width} height={homeConfig.media.data.height} loading="lazy" decoding="async" />
	</div>
</section>
