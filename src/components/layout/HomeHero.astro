---
import { homeConfig } from "@/config/homeConfig";
const firstDialogue = homeConfig.heroHud.dialogue[0];
---

<section class="home-hero" data-home-section="hero" data-home-visual="v22-character" aria-labelledby="home-hero-title">
	<img class="home-hero__media" src={homeConfig.media.hero.src} alt={homeConfig.media.hero.alt} width={homeConfig.media.hero.width} height={homeConfig.media.hero.height} loading="eager" fetchpriority="high" decoding="async" />
	<div class="home-hero__soft-light" aria-hidden="true"><i></i><i></i><i></i></div>
	<div class="home-hero__content">
		<p class="home-eyebrow">{homeConfig.eyebrow}</p>
		<p class="home-hero__brand">{homeConfig.brand}</p>
		<h1 id="home-hero-title">{homeConfig.title}</h1>
		<p class="home-hero__description">{homeConfig.description}</p>
		<nav class="home-hero__actions" aria-label={homeConfig.labels.heroActions}>
			{homeConfig.links.map((link, index) => (
				<a class:list={["home-action", index === 0 && "home-action--primary"]} href={link.href}>
					<span>{link.label}</span><small>{link.description}</small>
				</a>
			))}
		</nav>
	</div>
	<section class="home-hero-dialogue" data-home-dialogue data-dialogue-lines={JSON.stringify(homeConfig.heroHud.dialogue)} aria-label="首页引导">
		<header><strong data-home-dialogue-speaker>{firstDialogue.speaker}</strong><span>ENGINEERING LOG</span></header>
		<p data-home-dialogue-text role="button" tabindex="0" aria-label="继续首页对话">{firstDialogue.text}</p>
		<div class="home-hero-dialogue__controls">
			<button type="button" data-home-dialogue-action="back">↶ Back</button>
			<button type="button" data-home-dialogue-action="auto" aria-pressed="false">▶ Auto</button>
			<button type="button" data-home-dialogue-action="hide">× Hide</button>
		</div>
	</section>
	<button class="home-hero-dialogue__restore" type="button" data-home-dialogue-action="show" hidden>SHOW LOG</button>
	<div class="home-hero__floating-dock" aria-label="首页快捷工具">
		<a href="/search/" aria-label="打开站内搜索">SEARCH</a>
		<a href="/list/" aria-label="打开文章列表">LIST</a>
		<button type="button" data-home-hud-action="toggle" aria-pressed="true" aria-label="切换柔光装饰">LIGHT</button>
	</div>
	<p class="home-hero__index" aria-hidden="true">{homeConfig.labels.heroIndex}</p>
</section>
