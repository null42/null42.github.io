---
import { Icon } from "astro-icon/components";
import { url } from "@/utils/url-utils";
---

<nav class="mobile-dock" id="mobile-dock" aria-label="移动导航">
	<a href={url('/')} class="mobile-dock__item" aria-label="首页"><Icon is:inline name="material-symbols:home-rounded" /><span>首页</span></a>
	<a href={url('/knowledge/')} class="mobile-dock__item" aria-label="知识地图"><Icon is:inline name="material-symbols:account-tree-rounded" /><span>知识</span></a>
	<a href={url('/search/')} class="mobile-dock__item" aria-label="搜索"><Icon is:inline name="material-symbols:search-rounded" /><span>搜索</span></a>
	<a href={url('/list/')} class="mobile-dock__item" aria-label="文章列表"><Icon is:inline name="material-symbols:list-alt-rounded" /><span>文章</span></a>
	<button class="mobile-dock__item" id="mobile-dock-menu" type="button" aria-label="打开导航菜单" aria-controls="nav-menu-panel" aria-expanded="false"><Icon is:inline name="material-symbols:menu-rounded" /><span>菜单</span></button>
</nav>

<script>
	let mobileDockController: AbortController | undefined;

	function initMobileDock() {
		mobileDockController?.abort();
		mobileDockController = new AbortController();
		const signal = mobileDockController.signal;
		const button = document.getElementById("mobile-dock-menu");
		const panel = document.getElementById("nav-menu-panel");
		if (!button || !panel) return;

		const sync = () => button.setAttribute("aria-expanded", String(!panel.classList.contains("float-panel-closed")));
		button.addEventListener("click", () => {
			document.getElementById("nav-menu-switch")?.click();
			sync();
		}, { signal });
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && !panel.classList.contains("float-panel-closed")) {
				panel.classList.add("float-panel-closed");
				sync();
				button.focus();
			}
		}, { signal });
	}

	initMobileDock();
	document.addEventListener("astro:page-load", initMobileDock);
</script>
