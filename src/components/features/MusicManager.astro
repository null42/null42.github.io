---
import { musicPlayerConfig } from "@/config/musicConfig";

const tracks = musicPlayerConfig.local.playlist.map((track, index) => ({
	id: `local-${index + 1}`,
	title: track.name,
	artist: track.artist,
	src: track.url,
	cover: track.cover,
	lyrics: track.lrc,
}));
const configJson = JSON.stringify({
	tracks,
	volume: musicPlayerConfig.volume,
	loopMode: musicPlayerConfig.playMode,
});
---

<script is:inline id="music-player-bootstrap" type="application/json" set:html={configJson}></script>

<script>
	import { getGlobalMusicPlayerStore, initMusicPlayerViewLifecycle } from "@/utils/music-player-store";

	const bootstrap = document.getElementById("music-player-bootstrap");
	if (bootstrap?.textContent) {
		const config = JSON.parse(bootstrap.textContent);
		const store = getGlobalMusicPlayerStore(config);
		initMusicPlayerViewLifecycle({ store });
	}
</script>
