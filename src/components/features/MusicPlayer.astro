---
import { musicPlayerConfig } from "@/config/musicConfig";
import { url } from "@/utils/url-utils";

interface Props {
	full?: boolean;
	id?: string;
}

const { full = false, id } = Astro.props;
const tracks = musicPlayerConfig.local.playlist;
---

<section id={id} class:list={["music-player", { "music-player--full": full }]} data-music-player aria-label="本地音乐播放器">
	<div class="music-player__disc" aria-hidden="true"><span>♪</span></div>
	<div class="music-player__body">
		<div class="music-player__heading">
			<div>
				<strong data-music-title>{tracks[0]?.name}</strong>
				<span data-music-artist>{tracks[0]?.artist}</span>
			</div>
			<a class="music-player__page-link" href={url("/music/")}>完整播放器</a>
		</div>

		<div class="music-player__timeline">
			<span data-music-current>0:00</span>
			<input data-music-seek type="range" min="0" max="0" value="0" step="0.1" aria-label="播放进度" />
			<span data-music-duration>0:00</span>
		</div>

		<div class="music-player__controls">
			<button type="button" data-music-action="previous" aria-label="上一首">↶</button>
			<button type="button" class="music-player__primary" data-music-action="toggle" aria-label="播放" aria-pressed="false">▶</button>
			<button type="button" data-music-action="next" aria-label="下一首">↷</button>
			<button type="button" data-music-action="loop" aria-label="切换循环模式"><span data-music-loop>list</span></button>
			<button type="button" data-music-action="mute" aria-label="静音" aria-pressed="false">音量</button>
			<input data-music-volume type="range" min="0" max="1" value={musicPlayerConfig.volume ?? 0.7} step="0.05" aria-label="音量" />
		</div>

		<div class="music-player__lyrics" data-music-lyrics aria-live="polite">暂无歌词</div>
		<p class="music-player__error" data-music-error role="status" aria-live="polite" hidden></p>

		<p class="music-player__loading" data-music-loading role="status" aria-live="polite">正在缓冲音频…</p>

		{full && (
			<div class="music-player__playlist" aria-label="播放列表">
				<h2>播放列表</h2>
				{tracks.map((track, index) => (
					<button type="button" data-track-index={index}>
						<span>{track.name}</span>
						<small>{track.artist}</small>
					</button>
				))}
			</div>
		)}
	</div>
</section>

<style>
	.music-player{display:grid;grid-template-columns:auto minmax(0,1fr);gap:1rem;align-items:center;padding:1rem;border:1px solid color-mix(in srgb,var(--line-divider) 82%,transparent);border-radius:1.25rem;background:color-mix(in srgb,var(--card-bg) 92%,transparent);box-shadow:0 1rem 2.5rem rgba(18,28,34,.09)}
	.music-player__disc{display:grid;place-items:center;width:4.25rem;aspect-ratio:1;border-radius:50%;color:white;background:radial-gradient(circle at 50% 50%,#26353a 0 14%,#b86f80 15% 19%,#2d383d 20% 48%,#77b8a9 49% 52%,#222d31 53%);box-shadow:0 .75rem 1.8rem rgba(23,43,45,.2)}
	.music-player[data-music-playing="true"] .music-player__disc{animation:music-spin 8s linear infinite}
	.music-player__body{min-width:0;display:grid;gap:.8rem}
	.music-player[data-music-loading="true"] .music-player__disc{animation:music-pulse 1.2s ease-in-out infinite alternate}
	.music-player__heading{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem}
	.music-player__heading>div{min-width:0;display:grid;gap:.15rem}
	.music-player__heading strong,.music-player__heading span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
	.music-player__heading span{font-size:.78rem;color:var(--meta-divider)}
	.music-player__page-link{font-size:.75rem;color:var(--primary);white-space:nowrap}
	.music-player__timeline{display:grid;grid-template-columns:2.75rem minmax(0,1fr) 2.75rem;gap:.55rem;align-items:center;font-variant-numeric:tabular-nums;font-size:.7rem;color:var(--meta-divider)}
	.music-player input[type="range"]{width:100%;accent-color:var(--primary)}
	.music-player__controls{display:flex;align-items:center;gap:.45rem;flex-wrap:wrap}
	.music-player__controls button{min-height:2.1rem;padding:.35rem .65rem;border:1px solid var(--line-divider);border-radius:.75rem;background:var(--card-bg);color:var(--primary);cursor:pointer}
	.music-player__controls button:hover{border-color:var(--primary)}
	.music-player__controls .music-player__primary{min-width:2.6rem;color:white;background:var(--primary)}
	.music-player__controls [data-music-volume]{width:5.5rem}
	.music-player__lyrics{min-height:1.4rem;padding:.45rem .7rem;border-radius:.7rem;background:color-mix(in srgb,var(--primary) 8%,transparent);font-size:.8rem;color:var(--primary)}
	.music-player__error{margin:0;color:#dc2626;font-size:.78rem}
	.music-player__loading{margin:0;color:var(--meta-divider);font-size:.75rem}
	.music-player--full{grid-template-columns:8rem minmax(0,1fr);padding:clamp(1rem,3vw,2rem)}
	.music-player--full .music-player__disc{width:8rem}
	.music-player__playlist{display:grid;gap:.6rem;margin-top:.5rem}
	.music-player__playlist h2{margin:0;font-size:1rem}
	.music-player__playlist button{display:flex;justify-content:space-between;gap:1rem;padding:.8rem 1rem;border:1px solid var(--line-divider);border-radius:.8rem;background:transparent;text-align:left;color:inherit;cursor:pointer}
	.music-player__playlist button[data-active]{border-color:var(--primary);background:color-mix(in srgb,var(--primary) 8%,transparent)}
	.music-player__playlist small{color:var(--meta-divider)}
	@keyframes music-spin{to{transform:rotate(360deg)}}
	@keyframes music-pulse{to{transform:scale(.94);filter:saturate(.72)}}
	@media(max-width:42rem){.music-player,.music-player--full{grid-template-columns:1fr}.music-player__disc,.music-player--full .music-player__disc{width:5rem}.music-player__heading{align-items:center}.music-player__controls [data-music-volume]{flex:1;min-width:5rem}}
	@media(prefers-reduced-motion:reduce){.music-player[data-music-playing="true"] .music-player__disc,.music-player[data-music-loading="true"] .music-player__disc{animation:none}}
</style>
