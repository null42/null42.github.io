---
interface Props {
	payloadUrl: string;
}

const { payloadUrl } = Astro.props;
const idSuffix = payloadUrl.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "") || "content";
const passwordInputId = `encrypted-payload-password-${idSuffix}`;
const passwordDescriptionId = `encrypted-payload-description-${idSuffix}`;
const passwordErrorId = `encrypted-payload-error-${idSuffix}`;
---

<div class="encrypted-payload card-base p-6" data-encrypted-payload data-pagefind-ignore="all" data-payload-url={payloadUrl}>
	<h2 class="text-lg font-bold">加密文章</h2>
	<p id={passwordDescriptionId} class="text-sm opacity-70">请输入密码以读取加密内容。</p>
	<form class="encrypted-payload-form mt-4 space-y-2">
		<label for={passwordInputId} class="block text-sm font-medium">文章密码</label>
		<input id={passwordInputId} aria-describedby={`${passwordDescriptionId} ${passwordErrorId}`} class="w-full rounded-lg border p-2" type="password" autocomplete="current-password" placeholder="文章密码" />
		<button class="rounded-lg bg-(--primary) px-4 py-2 text-white" type="submit">解密</button>
	</form>
	<p id={passwordErrorId} class="encrypted-payload-error mt-2 hidden text-sm text-red-500" role="alert">密码错误或载荷无效。</p>
	<p class="encrypted-payload-status sr-only" role="status" aria-live="polite"></p>
	<div class="encrypted-payload-content markdown-content mt-4 hidden" tabindex="-1" aria-label="解密正文"></div>
</div>

<script>
	import mermaidRenderScript from "@/plugins/mermaid-render-script.js?raw";
	import plantumlRenderScript from "@/plugins/plantuml-render-script.js?raw";
	import { initEncryptedPayloadLifecycle } from "@/utils/encrypted-payload-controller";

	initEncryptedPayloadLifecycle({ mermaidRenderScript, plantumlRenderScript });
</script>
