---
import type { MarkdownHeading } from "astro";
import FloatingControls from "@/components/controls/FloatingControls.astro";
import ArticleReadingProgress from "@/components/knowledge/ArticleReadingProgress.astro";
import Live2DWidget from "@components/features/Live2DWidget.astro";
import SpineModel from "@components/features/SpineModel.astro";
import Footer from "@components/layout/Footer.astro";
import MobileDock from "@components/layout/MobileDock.astro";
import Navbar from "@components/layout/Navbar.astro";
import NavMenuPanel from "@components/layout/NavMenuPanel.astro";
import ArticleCatalog from "@components/misc/ArticleCatalog.astro";
import CategoryBar from "@/components/layout/CategoryBar.astro";
import { live2dWidgetConfig, navBarConfig, siteConfig } from "@/config";
import type { CatalogGroup } from "@/utils/content-utils";
import Layout from "./Layout.astro";

import "@/styles/expressive-code.css";
import "@/styles/markdown.css";
import "@/styles/toc.css";

import { filterEnabledNavLinks } from "@/utils/navigation-links";

interface Props {
	title?: string;
	banner?: string;
	knowledgeSidebar?: boolean;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	noindex?: boolean;
	postCategory?: string;
	headings?: MarkdownHeading[];
	catalogGroups?: CatalogGroup[];
	bannerPostMeta?: {
		title: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
	};
}

const {
	title,
	banner,
	knowledgeSidebar = false,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	noindex = false,
	postCategory,
	headings,
	catalogGroups,
} = Astro.props;

const isPostPage = Boolean(postSlug);
const isHomePage = Astro.url.pathname === "/";
const hasKnowledgeSlot = knowledgeSidebar && Astro.slots.has("knowledge-sidebar");
const shouldRenderCategoryBar = Boolean(siteConfig.categoryBar) && !isHomePage;
const enabledNavLinks = filterEnabledNavLinks(navBarConfig.links, siteConfig.pages);
---

<Layout
	title={title}
	banner={banner}
	description={description}
	lang={lang}
	setOGTypeArticle={setOGTypeArticle}
	postSlug={postSlug}
	noindex={noindex}
>
	<slot slot="head" name="head" />
	<div id="banner-dim-container" class="hidden" aria-hidden="true"></div>
	<div id="banner-overlay-container" class="hidden transition-swup-fade" aria-hidden="true"></div>

	<div data-firefly-mod-shell data-page-kind={isPostPage ? "post" : isHomePage ? "home" : "page"}>
		<header id="top-row">
			<div id="navbar-wrapper"><Navbar /></div>
		</header>

		<NavMenuPanel links={enabledNavLinks} />
		<MobileDock />

		<div id="main-grid-wrapper">
			<div id="main-grid" data-sidebar-position={hasKnowledgeSlot ? "knowledge" : isPostPage ? "article" : "none"}>
				<div id="left-sidebar-dynamic" class="hidden transition-swup-main"></div>
				<div id="right-sidebar-dynamic" class="hidden transition-swup-main"></div>

				<main
					id="swup-container"
					tabindex="-1"
					class="transition-swup-main"
					data-current-post-category={postCategory || ""}
				>
					{isPostPage && hasKnowledgeSlot ? (
						<aside class="knowledge-sidebar-rail" aria-label="知识导航">
							<slot name="knowledge-sidebar" />
						</aside>
					) : isPostPage && catalogGroups ? (
						<ArticleCatalog groups={catalogGroups} currentPostId={postSlug || ""} />
					) : null}

					{isPostPage && (
						<aside id="article-toc-wrapper" class="article-toc-wrapper" aria-label="文章目录">
							<div id="article-toc-container" class="article-toc-container">
								<ArticleReadingProgress />
								<header class="article-toc-header">目录</header>
								<div class="article-toc-body custom-scrollbar">
									<div class="toc-content" id="article-toc-content"></div>
								</div>
							</div>
						</aside>
					)}

					{shouldRenderCategoryBar && (
						<div id="category-bar-wrapper"><CategoryBar currentPostCategory={postCategory} /></div>
					)}

					{!isHomePage && title && <h1 class="sr-only">{title}</h1>}
					<div id="content-wrapper" class="onload-animation transition-leaving"><slot /></div>
					<div class="footer onload-animation mt-16 border-t pt-8"><Footer /></div>
				</main>

				<SpineModel />
				{live2dWidgetConfig.enable && <Live2DWidget config={live2dWidgetConfig} />}
			</div>
		</div>

	</div>
	<FloatingControls headings={headings} />
</Layout>

<script>
	import { syncArticleReadingProgress } from "@/utils/article-reading-progress-controller";
	import { TOCManager } from "@/utils/toc-utils";

	type ShellLifecycle = { dispose: () => void };
	const shellWindow = window as typeof window & { __fireflyModShellLifecycle?: ShellLifecycle };
	shellWindow.__fireflyModShellLifecycle?.dispose();

	const controller = new AbortController();
	let tocManager: TOCManager | null = null;
	let resizeObserver: ResizeObserver | null = null;
	let pendingTocTimer: ReturnType<typeof setTimeout> | null = null;

	function alignRails() {
		const grid = document.getElementById("main-grid");
		const content = document.getElementById("content-wrapper");
		if (!grid || !content) return;
		const gridRect = grid.getBoundingClientRect();
		const offset = Math.max(24, content.getBoundingClientRect().top - gridRect.top);
		// 侧边栏高度限定在 content-wrapper 范围内（不含 footer），
		// 避免 sticky 目录/目录卡片在滚动到底部时延伸到 footer 或与相关文章区域产生视觉重叠。
		const railHeight = Math.max(0, content.getBoundingClientRect().bottom - gridRect.top - offset);
		for (const rail of grid.querySelectorAll<HTMLElement>(".article-catalog-wrapper, .article-toc-wrapper, .knowledge-sidebar-rail")) {
			rail.style.top = `${offset}px`;
			rail.style.height = `${railHeight}px`;
		}
	}

	function initToc() {
		pendingTocTimer = null;
		tocManager?.cleanup();
		tocManager = null;
		syncArticleReadingProgress();
		if (!document.getElementById("article-toc-content")) return;
		tocManager = new TOCManager({
			contentId: "article-toc-content",
			indicatorId: "article-active-indicator",
			maxLevel: 3,
			scrollOffset: 80,
		});
		tocManager.init();
		alignRails();
	}

	function scheduleToc(delay: number) {
		if (pendingTocTimer !== null) clearTimeout(pendingTocTimer);
		pendingTocTimer = setTimeout(initToc, delay);
	}

	const disposeReadingProgress = () => window.articleReadingProgressController?.dispose();
	const handlePageView = () => scheduleToc(0);
	const attachSwupHooks = () => {
		window.swup?.hooks?.on("visit:start", disposeReadingProgress);
		window.swup?.hooks?.on("page:view", handlePageView);
	};

	initToc();
	attachSwupHooks();
	window.addEventListener("resize", alignRails, { signal: controller.signal });
	document.addEventListener("password:decrypted", () => scheduleToc(100), { signal: controller.signal });
	document.addEventListener("swup:enable", attachSwupHooks, { once: true, signal: controller.signal });

	const grid = document.getElementById("main-grid");
	if (grid) {
		resizeObserver = new ResizeObserver(alignRails);
		resizeObserver.observe(grid);
	}

	shellWindow.__fireflyModShellLifecycle = {
		dispose: () => {
			window.swup?.hooks?.off("visit:start", disposeReadingProgress);
			window.swup?.hooks?.off("page:view", handlePageView);
			controller.abort();
			if (pendingTocTimer !== null) clearTimeout(pendingTocTimer);
			pendingTocTimer = null;
			resizeObserver?.disconnect();
			resizeObserver = null;
			tocManager?.cleanup();
			tocManager = null;
			window.articleReadingProgressController?.dispose();
		},
	};
</script>
