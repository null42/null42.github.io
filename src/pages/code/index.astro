---
import fs from 'node:fs'
import path from 'node:path'
import MainGridLayout from '@/layouts/MainGridLayout.astro'
import manifest from '../../../content/code-library/manifest.json'

const libraryRoot = path.resolve('content/code-library')
const textByPath: Record<string, string> = {}
for (const project of manifest.projects) {
	for (const file of project.files) {
		if (file.binary) continue
		const absolute = path.resolve(libraryRoot, file.path)
		const relative = path.relative(libraryRoot, absolute)
		if (relative.startsWith('..') || path.isAbsolute(relative) || !fs.existsSync(absolute)) continue
		textByPath[file.path] = fs.readFileSync(absolute, 'utf8').replace(/\r\n/g, '\n')
	}
}
const firstFile = manifest.projects.flatMap(project => project.files).find(file => !file.binary)
const firstProject = manifest.projects.find(project => project.files.some(file => file.path === firstFile?.path))
const articleAssociations = Object.fromEntries(manifest.projects.map(project => [project.codeId, project.articles || []]))
---

<MainGridLayout title="代码资源库" description="文章关联的 FOC、IMU、仿真与状态估计代码">
	<section class="code-library" data-code-library data-active-file={firstFile?.path || ''} data-active-project={firstProject?.codeId || ''}>
		<header class="code-library__hero card-base"><p>CODE LIBRARY</p><h1>代码资源库</h1><span>{manifest.projects.length} 个项目 · {manifest.projects.reduce((sum, project) => sum + project.files.length, 0)} 个稳定文件</span></header>
		<div class="code-library__shell card-base">
			<aside class="code-library__tree" aria-label="代码项目与文件">
				{manifest.projects.map(project => <section><h2>{project.title}</h2><p>{project.description}</p><ul>{project.files.map(file => <li><button type="button" data-code-project={project.codeId} data-code-path={file.path} data-code-name={file.name} data-code-language={file.language} data-code-sha={file.sha256.slice(0, 12)} data-code-binary={String(file.binary)} class:list={{ active: file.path === firstFile?.path }}><span>{file.name}</span><small>{file.language}</small></button></li>)}</ul></section>)}
			</aside>
			<div class="code-library__viewer">
				<header><div><strong data-code-current>{firstFile?.name || '未选择文件'}</strong><span data-code-meta>{firstFile ? `${firstFile.language} · ${firstFile.sha256.slice(0, 12)}` : ''}</span></div><div><button type="button" data-code-copy>复制</button><a data-code-download href={firstFile ? `/code/raw/${firstFile.path}` : '#'} download>下载</a></div></header>
				<div class="code-library__error" data-code-error hidden role="alert"></div>
				<pre data-code-output tabindex="0"><code>{firstFile ? textByPath[firstFile.path] : ''}</code></pre>
				<section class="code-library__articles" data-code-articles aria-live="polite"></section>
			</div>
		</div>
		<script is:inline type="application/json" data-code-library-text set:html={JSON.stringify(textByPath).replace(/</g, '\u003c')}></script>
		<script is:inline type="application/json" data-code-library-articles set:html={JSON.stringify(articleAssociations).replace(/</g, '\u003c')}></script>
	</section>
</MainGridLayout>

<script>
	type CodeLibraryLifecycle = { dispose: () => void };
	const codeLibraryWindow = window as typeof window & { __codeLibraryLifecycle?: CodeLibraryLifecycle };
	codeLibraryWindow.__codeLibraryLifecycle?.dispose();
	const lifecycleController = new AbortController();
	let pageController: AbortController | undefined;
	let removePageViewHook: (() => void) | undefined;
	const initCodeLibrary = () => {
		pageController?.abort(); pageController = new AbortController();
		const root = document.querySelector<HTMLElement>('[data-code-library]'); if (!root) return;
		const data = JSON.parse(root.querySelector<HTMLScriptElement>('[data-code-library-text]')?.textContent || '{}') as Record<string, string>;
		const associations = JSON.parse(root.querySelector<HTMLScriptElement>('[data-code-library-articles]')?.textContent || '{}') as Record<string, Array<{ slug: string; title: string; references: Array<{ file: string; headingId: string; lines: string; label?: string }> }>>;
		const output = root.querySelector<HTMLElement>('[data-code-output] code'); const error = root.querySelector<HTMLElement>('[data-code-error]'); const current = root.querySelector<HTMLElement>('[data-code-current]'); const meta = root.querySelector<HTMLElement>('[data-code-meta]'); const download = root.querySelector<HTMLAnchorElement>('[data-code-download]'); const articles = root.querySelector<HTMLElement>('[data-code-articles]');
		const renderArticles = (projectId: string, fileName: string) => {
			if (!articles) return; articles.replaceChildren();
			const matches = (associations[projectId] || []).filter(article => article.references.some(reference => reference.file === fileName));
			const heading = document.createElement('strong'); heading.textContent = matches.length ? '关联文章' : '暂无关联文章'; articles.append(heading);
			for (const article of matches) { const link = document.createElement('a'); const reference = article.references.find(item => item.file === fileName); link.href = `/posts/${article.slug}/${reference?.headingId ? `#${encodeURIComponent(reference.headingId)}` : ''}`; link.textContent = `${article.title}${reference?.lines ? ` · ${reference.lines} 行` : ''}`; articles.append(link); }
		};
		const select = (button: HTMLButtonElement) => {
			const filePath = button.dataset.codePath || ''; const projectId = button.dataset.codeProject || ''; const fileName = button.dataset.codeName || filePath; const binary = button.dataset.codeBinary === 'true'; root.querySelectorAll('[data-code-path]').forEach(node => node.classList.toggle('active', node === button));
			if (current) current.textContent = fileName; if (meta) meta.textContent = `${button.dataset.codeLanguage || ''} · ${button.dataset.codeSha || ''}`; if (download) download.href = `/code/raw/${filePath}`;
			root.dataset.activeFile = filePath; root.dataset.activeProject = projectId; renderArticles(projectId, fileName);
			if (binary) { if (output) output.textContent = '此文件为二进制 Simulink 模型，请使用“下载”获取原文件。'; if (error) error.hidden = true; return; }
			if (!(filePath in data)) { if (output) output.textContent = ''; if (error) { error.hidden = false; error.textContent = `代码文件不存在或未导入：${filePath}`; } return; }
			if (error) error.hidden = true; if (output) output.textContent = data[filePath];
			const url = new URL(window.location.href); url.searchParams.set('codeId', projectId); url.searchParams.set('file', fileName); history.replaceState(history.state, '', `${url.pathname}${url.search}${url.hash}`);
		};
		root.addEventListener('click', event => { const target = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-code-path]') : null; if (target) select(target); }, { signal: pageController.signal });
		root.querySelector('[data-code-copy]')?.addEventListener('click', async () => { if (!output) return; await navigator.clipboard.writeText(output.textContent || ''); }, { signal: pageController.signal });
		const params = new URLSearchParams(window.location.search); const requestedProject = params.get('codeId'); const requestedFile = params.get('file');
		const requested = [...root.querySelectorAll<HTMLButtonElement>('[data-code-path]')].find(button => (!requestedProject || button.dataset.codeProject === requestedProject) && (!requestedFile || button.dataset.codeName === requestedFile || button.dataset.codePath === requestedFile));
		select(requested || root.querySelector<HTMLButtonElement>('[data-code-path].active') || root.querySelector<HTMLButtonElement>('[data-code-path]')!);
	};
	const attachSwupHook = () => { removePageViewHook?.(); removePageViewHook = window.swup?.hooks?.on('page:view', initCodeLibrary); };
	initCodeLibrary(); if (window.swup?.hooks) attachSwupHook(); else document.addEventListener('swup:enable', attachSwupHook, { once: true, signal: lifecycleController.signal });
	codeLibraryWindow.__codeLibraryLifecycle = { dispose: () => { lifecycleController.abort(); pageController?.abort(); removePageViewHook?.(); } };
</script>

<style>
	.code-library{display:grid;gap:1rem}.code-library__hero{display:grid;gap:.35rem;padding:clamp(1.2rem,3vw,2rem)}.code-library__hero p{margin:0;color:var(--primary);font-size:.72rem;font-weight:800;letter-spacing:.18em}.code-library__hero h1{margin:0}.code-library__hero span,.code-library__tree p,.code-library__viewer header span{color:var(--content-meta)}.code-library__shell{display:grid;grid-template-columns:minmax(15rem,22rem) minmax(0,1fr);min-height:70vh;overflow:hidden}.code-library__tree{max-height:75vh;overflow:auto;padding:1rem;border-right:1px solid var(--line-divider)}.code-library__tree section+section{margin-top:1.25rem}.code-library__tree h2{margin:0;font-size:1rem}.code-library__tree p{margin:.25rem 0 .6rem;font-size:.78rem}.code-library__tree ul{display:grid;gap:.25rem;margin:0;padding:0;list-style:none}.code-library__tree button{display:flex;width:100%;justify-content:space-between;gap:.5rem;padding:.5rem .6rem;border:0;border-radius:.5rem;background:transparent;color:inherit;text-align:left;cursor:pointer}.code-library__tree button.active{background:var(--btn-regular-bg-hover);color:var(--primary)}.code-library__viewer{display:grid;grid-template-rows:auto auto minmax(0,1fr) auto;min-width:0;background:#11161d;color:#d8e2ec}.code-library__viewer>header{display:flex;justify-content:space-between;gap:1rem;padding:.8rem 1rem;border-bottom:1px solid #ffffff1f}.code-library__viewer>header>div{display:flex;align-items:center;gap:.6rem}.code-library__viewer button,.code-library__viewer a{border:1px solid #ffffff2b;border-radius:.5rem;padding:.4rem .65rem;background:#ffffff0f;color:inherit;text-decoration:none;cursor:pointer}.code-library__viewer pre{max-height:70vh;margin:0;overflow:auto;padding:1rem;font:13px/1.65 var(--font-jetbrains-mono),ui-monospace,monospace;white-space:pre}.code-library__articles{display:flex;align-items:center;gap:.65rem;overflow:auto;padding:.65rem 1rem;border-top:1px solid #ffffff1f}.code-library__articles>a{white-space:nowrap}.code-library__error{padding:.7rem 1rem;background:#7f1d1d;color:white}@media(max-width:48rem){.code-library__shell{grid-template-columns:1fr}.code-library__tree{max-height:18rem;border-right:0;border-bottom:1px solid var(--line-divider)}.code-library__viewer pre{max-height:65vh}.code-library__viewer>header{align-items:flex-start;flex-direction:column}.code-library__articles{align-items:flex-start;flex-direction:column}}
</style>
