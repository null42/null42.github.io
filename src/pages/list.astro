---
import ArticleVirtualList from "@/components/pages/ArticleVirtualList.svelte";
import defaultArticleCover from "@/assets/images/cover.avif";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { getArticleIndexPresentation, isPublicArticle } from "@/utils/article-index";
import { getCategoryUrl, getPostUrlBySlug, getTagUrl } from "@/utils/url-utils";
import knowledgeNavigation from "@/generated/knowledge-navigation.json";

const title = "文章列表";
const posts = (await getSortedPosts()).filter(({ data }) => isPublicArticle(data));
const formatter = new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
const virtualPosts = posts.map((post) => {
	const presentation = getArticleIndexPresentation(post.data);
	return {
		articleId: post.data.articleId,
		title: post.data.title,
		url: getPostUrlBySlug(post.id),
		description: presentation === "encrypted-placeholder" ? "该文章已加密，请打开后验证访问权限" : (post.data.description || "阅读文章详情"),
		publishedIso: post.data.published.toISOString(),
		publishedText: formatter.format(post.data.published),
		imageUrl: post.data.image || defaultArticleCover.src,
		imageAlt: `${post.data.title}封面`,
		pinned: post.data.pinned,
		encrypted: presentation === "encrypted-placeholder",
		category: post.data.category || "",
		categoryUrl: getCategoryUrl(post.data.category),
		tagLinks: post.data.tags.map((tag) => ({ label: tag, url: getTagUrl(tag) })),
		sectionId: post.data.sectionId,
		routeId: post.data.routeId,
		stageId: post.data.stageId,
	};
});
const sections = knowledgeNavigation.map((section) => ({ id: section.id, title: section.title }));
const routes = knowledgeNavigation.flatMap((section) => section.routes.map((route) => ({ id: route.id, title: route.title, sectionId: section.id })));
const stages = knowledgeNavigation.flatMap((section) => section.routes.flatMap((route) => route.stages.map((stage) => ({ id: stage.id, title: stage.title, sectionId: section.id, routeId: route.id }))));
---

<MainGridLayout title={title} description="浏览全部公开文章">
	<ArticleVirtualList posts={virtualPosts} sections={sections} routes={routes} stages={stages} batchSize={48} />
</MainGridLayout>

<script>
	import { installArticleIndexLifecycle } from "@/utils/article-index-controller";
	const install = () => installArticleIndexLifecycle(window.swup);
	install();
	if (!window.swup?.hooks) {
		document.addEventListener("swup:enable", install, { once: true });
	}
</script>
