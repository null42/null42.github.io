---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 占位打赏渠道（非真实二维码）
const channels = [
	{
		name: "微信",
		description: "微信收款码占位",
		hint: "请使用微信扫描左侧占位区域（演示用途）",
		accent: "weixin",
	},
	{
		name: "支付宝",
		description: "支付宝收款码占位",
		hint: "请使用支付宝扫描左侧占位区域（演示用途）",
		accent: "alipay",
	},
];
---

<MainGridLayout title="打赏" description="占位打赏页面，仅展示卡片样式，不包含真实二维码。">
	<section class="sponsor-page">
		<header class="sponsor-hero card-base">
			<p class="sponsor-eyebrow">SPONSOR</p>
			<h1>打赏</h1>
			<p class="sponsor-sub">
				如果内容对你有帮助，可以请作者喝杯咖啡。下方为占位卡片，并非真实收款码，请勿扫码转账。
			</p>
		</header>

		<div class="sponsor-grid">
			{channels.map((channel) => (
				<article class="sponsor-card card-base">
					<div class="sponsor-qr" aria-hidden="true">
						<div class="sponsor-qr-grid" data-accent={channel.accent}></div>
						<span class="sponsor-qr-text">{channel.description}</span>
					</div>
					<div class="sponsor-info">
						<h2>{channel.name}</h2>
						<p>{channel.hint}</p>
					</div>
				</article>
			))}
		</div>

		<p class="sponsor-footnote">本页面为视觉占位实现，所有二维码均为占位图形，请勿扫码。</p>
	</section>
</MainGridLayout>

<style>
	.sponsor-page {
		display: grid;
		gap: 1.5rem;
	}

	.sponsor-hero {
		display: grid;
		gap: 0.4rem;
		padding: clamp(1.25rem, 3vw, 2rem);
	}

	.sponsor-eyebrow {
		margin: 0;
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.18em;
	}

	.sponsor-hero h1 {
		margin: 0;
		font-size: clamp(1.6rem, 4vw, 2.4rem);
	}

	.sponsor-sub {
		margin: 0;
		color: var(--meta-divider);
		font-size: 0.92rem;
		line-height: 1.6;
	}

	.sponsor-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: 1rem;
	}

	.sponsor-card {
		display: grid;
		gap: 1rem;
		padding: 1.5rem;
		text-align: center;
		border: 1px solid var(--line-divider);
	}

	.sponsor-qr {
		position: relative;
		aspect-ratio: 1 / 1;
		border-radius: var(--radius-large);
		border: 1px dashed var(--line-divider);
		background: var(--btn-regular-bg);
		display: grid;
		place-items: center;
		overflow: hidden;
	}

	.sponsor-qr-grid {
		position: absolute;
		inset: 12%;
		background-image:
			linear-gradient(var(--line-divider) 1px, transparent 1px),
			linear-gradient(90deg, var(--line-divider) 1px, transparent 1px);
		background-size: 12.5% 12.5%;
		opacity: 0.6;
	}

	.sponsor-qr-grid[data-accent="weixin"] {
		background-color: color-mix(in oklch, var(--primary) 8%, transparent);
	}

	.sponsor-qr-grid[data-accent="alipay"] {
		background-color: color-mix(in oklch, var(--primary) 12%, transparent);
	}

	.sponsor-qr-text {
		position: relative;
		z-index: 1;
		padding: 0.45rem 0.85rem;
		border-radius: 999px;
		background: var(--card-bg);
		color: var(--primary);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		box-shadow: var(--shadow-sm);
	}

	.sponsor-info {
		display: grid;
		gap: 0.35rem;
	}

	.sponsor-info h2 {
		margin: 0;
		font-size: 1.1rem;
		font-weight: 700;
	}

	.sponsor-info p {
		margin: 0;
		color: var(--content-meta);
		font-size: 0.85rem;
		line-height: 1.6;
	}

	.sponsor-footnote {
		margin: 0;
		text-align: center;
		color: var(--meta-divider);
		font-size: 0.8rem;
	}
</style>
