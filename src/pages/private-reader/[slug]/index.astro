---
/**
 * 私密阅读器单本书路由（v2 三层解密架构）
 *
 * 从 content/private-reader/[slug]/manifest.json 读取加密 manifest，
 * 渲染 PrivateReaderShell（Book 密码门 + 阅读器）。
 *
 * 安全：
 * - 静态 HTML 中不包含任何明文（标题、作者、内容）
 * - manifest 中的加密字段通过 data-* 属性传递给浏览器端
 * - 路由不进 Sitemap/Pagefind/导航
 * - 必须在 siteConfig.pages.privateReader === true 时才生成
 */
import MainGridLayout from "@/layouts/MainGridLayout.astro"
import PrivateReaderShell from "@/components/private-reader/PrivateReaderShell.astro"
import { siteConfig } from "@/config"
import fs from "node:fs"
import path from "node:path"

// 枚举 content/private-reader/ 下的所有书籍，为静态构建生成路由
export function getStaticPaths() {
	if (!siteConfig.pages.privateReader) return []

	const baseDir = path.resolve("content/private-reader")
	if (!fs.existsSync(baseDir)) return []

	const entries = fs.readdirSync(baseDir, { withFileTypes: true })
		.filter((entry) => entry.isDirectory())
		.map((dir) => dir.name)
		.filter((slug) => {
			const manifestPath = path.resolve(baseDir, slug, "manifest.json")
			if (!fs.existsSync(manifestPath)) return false
			try {
				const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"))
				// 支持 v1 和 v2 schema
				return manifest.schema === "private-reader/v1" || manifest.schema === "private-reader/v2"
			} catch {
				return false
			}
		})

	return entries.map((slug) => ({
		params: { slug },
		props: { slug },
	}))
}

const { slug } = Astro.props

// 未开启则 404
if (!siteConfig.pages.privateReader) {
	return Astro.redirect("/404")
}

if (!slug) {
	return Astro.redirect("/private-reader/")
}

const manifestPath = path.resolve("content/private-reader", slug, "manifest.json")

if (!fs.existsSync(manifestPath)) {
	return Astro.redirect("/404")
}

let manifest: any
try {
	manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"))
} catch {
	return Astro.redirect("/404")
}

if (manifest.schema !== "private-reader/v1" && manifest.schema !== "private-reader/v2") {
	return Astro.redirect("/404")
}
---

<MainGridLayout title="私密阅读" description="加密文档本地解密阅读。" noindex={true}>
	<PrivateReaderShell manifest={manifest} />
</MainGridLayout>
