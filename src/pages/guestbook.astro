---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout
	title="留言板"
	description="留言板功能暂未开放，需要后端评论系统支持。"
>
	<section class="guestbook-page">
		<div class="guestbook-card card-base">
			<div class="guestbook-icon" aria-hidden="true">
				<Icon is:inline name="material-symbols:construction" class="guestbook-icon-svg" />
			</div>
			<p class="guestbook-eyebrow">GUESTBOOK</p>
			<h1>暂未开放</h1>
			<p class="guestbook-message">
				留言板依赖后端评论系统（如 Artalk、Waline、Giscus 等），当前尚未完成相关配置。
			</p>
			<p class="guestbook-hint">
				待后端服务接入并启用评论组件后，本页面将自动切换为可交互留言视图。
			</p>

			<div class="guestbook-tags" aria-hidden="true">
				<span>需后端配置</span>
				<span>评论系统未启用</span>
				<span>规划中</span>
			</div>
		</div>
	</section>
</MainGridLayout>

<style>
	.guestbook-page {
		display: grid;
		gap: 1.5rem;
	}

	.guestbook-card {
		display: grid;
		justify-items: center;
		gap: 0.6rem;
		padding: clamp(2rem, 6vw, 3.5rem);
		text-align: center;
		min-height: 18rem;
		border: 1px solid var(--line-divider);
	}

	.guestbook-icon {
		display: grid;
		place-items: center;
		width: 4rem;
		height: 4rem;
		border-radius: var(--radius-large);
		background: var(--btn-regular-bg);
		color: var(--primary);
	}

	.guestbook-icon-svg {
		width: 2rem;
		height: 2rem;
	}

	.guestbook-eyebrow {
		margin: 0;
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.18em;
	}

	.guestbook-card h1 {
		margin: 0;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
	}

	.guestbook-message {
		margin: 0;
		max-width: 32rem;
		color: var(--content-meta);
		font-size: 0.95rem;
		line-height: 1.7;
	}

	.guestbook-hint {
		margin: 0;
		max-width: 32rem;
		color: var(--meta-divider);
		font-size: 0.85rem;
		line-height: 1.65;
	}

	.guestbook-tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.45rem;
		margin-top: 0.75rem;
	}

	.guestbook-tags span {
		padding: 0.25rem 0.7rem;
		border-radius: 999px;
		background: var(--btn-regular-bg);
		color: var(--content-meta);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.04em;
	}
</style>
