VITE_GISCUS_REPO=null42/null42.github.io
VITE_GISCUS_REPO_ID=
VITE_GISCUS_CATEGORY=General
VITE_GISCUS_CATEGORY_ID=

# 加密文章密码（用于 scripts/kb/encrypt/encrypt.ts）
# 真实值仅通过环境变量或 GitHub Actions Secret 注入，绝不提交到仓库
KB_ENCRYPT_PASSWORD=

# 私密阅读系统密码（用于 npm run private-reader:encrypt）
# 与 KB_ENCRYPT_PASSWORD 分离，便于不同书使用不同密码
# 真实值仅通过环境变量或 GitHub Actions Secret 注入，绝不提交到仓库
KB_READER_PASSWORD=
